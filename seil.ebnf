seil-text        ::= form-ws? seil-form form-ws? top-form* form-ws?

seil-form        ::= "(" "seil" ws version form-ws? ")"

version          ::= digits ws digits

top-form         ::= module-form
                   | import-form
                   | export-form
                   | type-form
                   | sig-form
                   | global-form
                   | const-form
                   | extern-form
                   | intern-form
                   | func-form

module-form      ::= "(" "module" ws module-desc form-body? ")"

import-form      ::= "(" "import" ws module-desc ws string meta-form* form-ws? ")"

export-form      ::= "(" "export" ws ref-desc ws string meta-form* form-ws? ")"

type-form        ::= "(" "type" ws type-desc ws type-kind type-member* form-ws? ")"

sig-form         ::= "(" "sig" ws sig-desc sig-member* form-ws? ")"

global-form      ::= "(" "global" ws global-desc ws type-ref meta-form* form-ws? ")"

const-form       ::= "(" "const" ws const-desc ws type-ref ws literal meta-form* form-ws? ")"

extern-form      ::= "(" "extern" ws func-desc ws sig-desc meta-form* form-ws? ")"

intern-form      ::= "(" "intern" ws func-desc ws sig-desc meta-form* form-ws? ")"

func-form        ::= "(" "func" ws func-desc ws sig-desc func-member* form-ws? ")"

form-body        ::= meta-form* form-ws?

type-kind        ::= "prod"
                     | "sum"

type-member      ::= form-ws? (meta-form | field-form | alt-form)

sig-member       ::= form-ws? (meta-form | input-form | output-form)

func-member      ::= form-ws? (meta-form | local-form | env-form | entry-form | region-form | body-form)

meta-form        ::= "(" "meta" ws ident meta-arg* form-ws? ")"

meta-arg         ::= ws (named-meta-arg | meta-value)

named-meta-arg   ::= "(" ident ws ":=" ws meta-value form-ws? ")"

meta-value       ::= ident
                     | string
                     | number
                     | ref-desc

field-form       ::= "(" "field" ws ident ws type-ref form-ws? ")"

alt-form         ::= "(" "alt" ws ident ws "tag" ws number (ws "payld" ws type-ref)? form-ws? ")"

input-form       ::= "(" "input" ws (ident ws type-ref | type-ref) form-ws? ")"

output-form      ::= "(" "output" ws type-ref form-ws? ")"

local-form       ::= "(" "local" ws number ws (ident ws type-ref | type-ref) form-ws? ")"

env-form         ::= "(" "env" ws number ws (ident ws type-ref | type-ref) form-ws? ")"

entry-form       ::= "(" "entry" ws ident form-ws? ")"

region-form      ::= "(" "region" ws ident ws ident ws ident ws ident ws ident form-ws? ")"

body-form        ::= "(" "body" body-ws? body-line* body-ws? ")"

body-line        ::= body-ws? (comment | label-line | instruction-line)? line-end

comment          ::= ";" comment-text

label-line       ::= ident ":"

instruction-line ::= mnemonic (ws operand)*

mnemonic         ::= ident ("." ident)*

operand          ::= number
                     | string
                     | ident
                     | ref-desc

ref-desc         ::= module-desc
                     | type-desc
                     | sig-desc
                     | func-desc
                     | global-desc
                     | const-desc
                     | product-desc
                     | alt-desc

module-desc      ::= "M" "<" path ">"

type-desc        ::= "T" "<" path ">"

sig-desc         ::= "S" "<" path ">"

func-desc        ::= "F" "<" path ">"

global-desc      ::= "G" "<" path ">"

const-desc       ::= "K" "<" path ">"

product-desc     ::= "P" "<" path "/" ident ">"

alt-desc         ::= "A" "<" path "/" ident ">"

type-ref         ::= primitive-type
                     | type-desc

primitive-type   ::= "Bit"
                     | "Byte"
                     | "i8"
                     | "i16"
                     | "i32"
                     | "i64"
                     | "n8"
                     | "n16"
                     | "n32"
                     | "n64"
                     | "f32"
                     | "f64"
                     | "ptr"
                     | "ref"

path             ::= ident ("/" ident)*

literal          ::= number
                     | string
                     | bytes-literal
                     | "nil"
                     | "true"
                     | "false"

bytes-literal    ::= "x\"" hex-pair (ws? hex-pair)* "\""

hex-pair         ::= hex-digit hex-digit

ident            ::=  /* lexical identifier token */

number           ::=  /* lexical numeric token */

string           ::=  /* lexical string token */

digits           ::=  /* one or more decimal digits */

hex-digit        ::=  /* 0..9 a..f A..F */

ws               ::=  /* one or more horizontal whitespace chars */

form-ws          ::=  /* whitespace or comments between forms */

body-ws          ::=  /* whitespace inside body form before/after body lines */

line-end         ::=  /* newline or EOF */

comment-text     ::=  /* chars until line-end */
