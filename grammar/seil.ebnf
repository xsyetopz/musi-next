seil-text           ::= form-ws? module form-ws?

module              ::= "(" "module" ws module-name module-decl* form-ws? ")"

module-decl         ::= form-ws? (asm-decl
                                  | asmref-decl
                                  | file-decl
                                  | import-decl
                                  | export-decl
                                  | type-decl
                                  | sig-decl
                                  | global-decl
                                  | const-decl
                                  | proc-decl
                                  | ext-decl
                                  | tool-decl)

asm-decl            ::= "(" "asm" ws symbol asm-member* form-ws? ")"

asmref-decl         ::= "(" "asmref" ws symbol asmref-member* form-ws? ")"

asm-member          ::= form-ws? (ver-decl
                                  | cap-decl
                                  | runtime-decl
                                  | entry-decl
                                  | meta-decl)

asmref-member       ::= form-ws? (ver-decl
                                  | origin-decl
                                  | pubkey-decl
                                  | culture-decl
                                  | meta-decl)

ver-decl            ::= "(" "ver" ws number ws number ws number ws number form-ws? ")"

cap-decl            ::= "(" "cap" ws symbol meta-decl* form-ws? ")"

runtime-decl        ::= "(" "runtime" ws symbol meta-decl* form-ws? ")"

entry-decl          ::= "(" "entry" ws symbol form-ws? ")"

origin-decl         ::= "(" "origin" ws string form-ws? ")"

pubkey-decl         ::= "(" "pubkey" ws bytes-literal form-ws? ")"

culture-decl        ::= "(" "culture" ws string form-ws? ")"

file-decl           ::= "(" "file" ws string file-member* form-ws? ")"

file-member         ::= form-ws? (digest-decl | meta-decl)

digest-decl         ::= "(" "digest" ws symbol ws bytes-literal form-ws? ")"

import-decl         ::= "(" "import" ws symbol ws string meta-decl* form-ws? ")"

export-decl         ::= "(" "export" ws symbol ws string meta-decl* form-ws? ")"

type-decl           ::= "(" "type" ws symbol type-member* form-ws? ")"

type-member         ::= form-ws? (layout-decl | field-decl | alt-decl | meta-decl)

layout-decl         ::= "(" "layout" ws layout-kind layout-member* form-ws? ")"

layout-kind         ::= "scalar"
                       | "product"
                       | "tagged"
                       | "array"
                       | "opaque"

layout-member       ::= form-ws? meta-decl

field-decl          ::= "(" "field" ws symbol ws type-ref field-member* form-ws? ")"

field-member        ::= form-ws? meta-decl

alt-decl            ::= "(" "alt" ws symbol ws number (ws type-ref)? alt-member* form-ws? ")"

alt-member          ::= form-ws? meta-decl

sig-decl            ::= "(" "sig" ws symbol sig-member* form-ws? ")"

sig-member          ::= form-ws? (in-decl | out-decl | meta-decl)

in-decl             ::= "(" "in" ws (symbol ws type-ref | type-ref) form-ws? ")"

out-decl            ::= "(" "out" ws type-ref form-ws? ")"

global-decl         ::= "(" "global" ws symbol ws type-ref global-member* form-ws? ")"

global-member       ::= form-ws? meta-decl

const-decl          ::= "(" "const" ws symbol ws type-ref ws literal const-member* form-ws? ")"

const-member        ::= form-ws? meta-decl

proc-decl           ::= "(" "proc" ws symbol ws sig-ref proc-member* proc-body? form-ws? ")"

proc-member         ::= form-ws? (local-decl
                                  | env-decl
                                  | region-decl
                                  | extern-decl
                                  | intrin-decl
                                  | meta-decl)

proc-body           ::= body-ws? body-line+

local-decl          ::= "(" "local" ws symbol ws type-ref form-ws? ")"

env-decl            ::= "(" "env" ws symbol ws type-ref form-ws? ")"

region-decl         ::= "(" "region" ws symbol region-member* form-ws? ")"

region-member       ::= form-ws? meta-decl

extern-decl         ::= "(" "extern" extern-member* form-ws? ")"

extern-member       ::= form-ws? (abi-decl | symbol-decl | meta-decl)

intrin-decl         ::= "(" "intrin" intrin-member* form-ws? ")"

intrin-member       ::= form-ws? (runtime-decl | symbol-decl | meta-decl)

abi-decl            ::= "(" "abi" ws symbol form-ws? ")"

symbol-decl         ::= "(" "symbol" ws string form-ws? ")"

body-line           ::= body-ws? (comment | label-line | instruction-line)? line-end

comment             ::= ";" comment-text

label-line          ::= symbol ":"

instruction-line    ::= mnemonic (ws operand)*

mnemonic            ::= ident ("." ident)*

operand             ::= literal
                       | symbol
                       | type-ref
                       | sig-ref

ext-decl            ::= "(" "ext" ws symbol ext-member* form-ws? ")"

ext-member          ::= form-ws? (section-decl | opcode-decl | meta-decl)

section-decl        ::= "(" "section" ws number ws section-policy meta-decl* form-ws? ")"

section-policy      ::= "required"
                       | "skippable"

opcode-decl         ::= "(" "opcode" ws number ws number meta-decl* form-ws? ")"

tool-decl           ::= "(" "tool" tool-member* form-ws? ")"

tool-member         ::= form-ws? meta-decl

meta-decl           ::= "(" "meta" ws symbol meta-arg* form-ws? ")"

meta-arg            ::= ws (named-meta-arg | meta-value)

named-meta-arg      ::= "(" symbol ws ":=" ws meta-value form-ws? ")"

meta-value          ::= literal
                       | symbol
                       | type-ref
                       | sig-ref

module-name         ::= symbol

sig-ref             ::= symbol

type-ref            ::= primitive-type
                       | "(" "ref" ws type-ref form-ws? ")"
                       | "(" "ptr" ws type-ref form-ws? ")"
                       | symbol

primitive-type      ::= "Bit"
                       | "Byte"
                       | "i8"
                       | "i16"
                       | "i32"
                       | "i64"
                       | "n8"
                       | "n16"
                       | "n32"
                       | "n64"
                       | "f32"
                       | "f64"

symbol              ::= bare-symbol
                       | escaped-symbol

bare-symbol         ::=  /* lexical symbol token excluding SEIL reserved words in directive-head position */

escaped-symbol      ::= "`" escaped-symbol-body "`"

escaped-symbol-body ::=  /* non-newline chars with backslash escaping for ` and \ */

ident               ::=  /* lexical opcode mnemonic part */

number              ::=  /* lexical numeric token */

string              ::=  /* lexical string token */

literal             ::= number
                       | string
                       | bytes-literal
                       | "nil"
                       | "true"
                       | "false"

bytes-literal       ::= "x\"" hex-pair (ws? hex-pair)* "\""

hex-pair            ::= hex-digit hex-digit

hex-digit           ::=  /* 0..9 a..f A..F */

ws                  ::=  /* one or more horizontal whitespace chars */

form-ws             ::=  /* whitespace or comments between forms */

body-ws             ::=  /* whitespace inside proc before/after body lines */

line-end            ::=  /* newline or EOF */

comment-text        ::=  /* chars until line-end */
