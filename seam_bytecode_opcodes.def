// Core SEAM bytecode opcode definitions.
// This is a Swift/LLVM-style .def file.
// Define SEAM_BYTECODE_OPCODE before including this file.
// Field order: swiftCase, rawValue, mnemonic, operands, stackEffect.
// Mnemonics use the canonical SEAM bytecode spelling.

#ifndef SEAM_BYTECODE_OPCODE
#define SEAM_BYTECODE_OPCODE(SWIFT_CASE, RAW_VALUE, MNEMONIC, OPERANDS, STACK_EFFECT)
#endif

SEAM_BYTECODE_OPCODE(bad, 0x0000, "bad", "none", "bad")
SEAM_BYTECODE_OPCODE(nop, 0x0001, "nop", "none", "... -> ...")
SEAM_BYTECODE_OPCODE(ret, 0x0002, "ret", "none", "..., outputs(current) -> terminal")
SEAM_BYTECODE_OPCODE(br, 0x0003, "br", "block_idx", "... -> terminal")
SEAM_BYTECODE_OPCODE(brTrue, 0x0004, "br.true", "block_idx", "..., Bit -> terminal-or-next")
SEAM_BYTECODE_OPCODE(brFalse, 0x0005, "br.false", "block_idx", "..., Bit -> terminal-or-next")
SEAM_BYTECODE_OPCODE(brTbl, 0x0006, "br.tbl", "table_idx", "..., Nat -> terminal")
SEAM_BYTECODE_OPCODE(leave, 0x0007, "leave", "region_idx", "... -> terminal-or-region-exit")
SEAM_BYTECODE_OPCODE(trap, 0x0008, "trap", "none", "... -> terminal")
SEAM_BYTECODE_OPCODE(throwOp, 0x0009, "throw", "none", "..., T -> terminal")
SEAM_BYTECODE_OPCODE(rethrowOp, 0x000A, "rethrow", "none", "... -> terminal")
SEAM_BYTECODE_OPCODE(drop, 0x0100, "drop", "none", "..., A -> ...")
SEAM_BYTECODE_OPCODE(dup, 0x0101, "dup", "none", "..., A -> ..., A, A")
SEAM_BYTECODE_OPCODE(swap, 0x0102, "swap", "none", "..., A, B -> ..., B, A")
SEAM_BYTECODE_OPCODE(rot, 0x0103, "rot", "none", "..., A, B, C -> ..., B, C, A")
SEAM_BYTECODE_OPCODE(const, 0x0200, "const", "const_idx", "... -> ..., T")
SEAM_BYTECODE_OPCODE(constBit, 0x0202, "const.bit", "u8", "... -> ..., Bit")
SEAM_BYTECODE_OPCODE(constNil, 0x0203, "const.nil", "type_idx", "... -> ..., T")
SEAM_BYTECODE_OPCODE(constInt, 0x0210, "const.int", "type_idx, vari", "... -> ..., T")
SEAM_BYTECODE_OPCODE(constNat, 0x0211, "const.nat", "type_idx, varu", "... -> ..., T")
SEAM_BYTECODE_OPCODE(constFlt, 0x0212, "const.flt", "type_idx, f64", "... -> ..., T")
SEAM_BYTECODE_OPCODE(constTxt, 0x0213, "const.txt", "const_idx", "... -> ..., T")
SEAM_BYTECODE_OPCODE(constBytes, 0x0214, "const.bytes", "const_idx", "... -> ..., T")
SEAM_BYTECODE_OPCODE(ldArg, 0x0300, "ld.arg", "arg_idx", "... -> ..., T")
SEAM_BYTECODE_OPCODE(ldLoc, 0x0301, "ld.loc", "loc_idx", "... -> ..., T")
SEAM_BYTECODE_OPCODE(stLoc, 0x0302, "st.loc", "loc_idx", "..., T -> ...")
SEAM_BYTECODE_OPCODE(ldEnv, 0x0303, "ld.env", "env_idx", "... -> ..., T")
SEAM_BYTECODE_OPCODE(stEnv, 0x0304, "st.env", "env_idx", "..., T -> ...")
SEAM_BYTECODE_OPCODE(ldGlob, 0x0305, "ld.glob", "global_idx", "... -> ..., T")
SEAM_BYTECODE_OPCODE(stGlob, 0x0306, "st.glob", "global_idx", "..., T -> ...")
SEAM_BYTECODE_OPCODE(call, 0x0400, "call", "func_idx", "..., inputs(S) -> ..., outputs(S)")
SEAM_BYTECODE_OPCODE(callDisp, 0x0401, "call.disp", "func_idx", "..., receiver, inputs(S) -> ..., outputs(S)")
SEAM_BYTECODE_OPCODE(callInd, 0x0402, "call.ind", "sig_idx", "..., Fn[S], inputs(S) -> ..., outputs(S)")
SEAM_BYTECODE_OPCODE(callDyn, 0x0403, "call.dyn", "sig_idx", "..., callee, argpack -> ..., outputs(S)")
SEAM_BYTECODE_OPCODE(mkFn, 0x0404, "mk.fn", "func_idx", "..., env? -> ..., Fn[S]")
SEAM_BYTECODE_OPCODE(add, 0x0500, "add", "none", "..., T, T -> ..., T")
SEAM_BYTECODE_OPCODE(sub, 0x0501, "sub", "none", "..., T, T -> ..., T")
SEAM_BYTECODE_OPCODE(mul, 0x0502, "mul", "none", "..., T, T -> ..., T")
SEAM_BYTECODE_OPCODE(div, 0x0503, "div", "none", "..., T, T -> ..., T")
SEAM_BYTECODE_OPCODE(divUn, 0x0504, "div.un", "none", "..., T, T -> ..., T")
SEAM_BYTECODE_OPCODE(rem, 0x0505, "rem", "none", "..., T, T -> ..., T")
SEAM_BYTECODE_OPCODE(remUn, 0x0506, "rem.un", "none", "..., T, T -> ..., T")
SEAM_BYTECODE_OPCODE(neg, 0x0507, "neg", "none", "..., T -> ..., T")
SEAM_BYTECODE_OPCODE(abs, 0x0508, "abs", "none", "..., T -> ..., T")
SEAM_BYTECODE_OPCODE(addChk, 0x0509, "add.chk", "none", "..., T, T -> ..., T")
SEAM_BYTECODE_OPCODE(subChk, 0x050A, "sub.chk", "none", "..., T, T -> ..., T")
SEAM_BYTECODE_OPCODE(mulChk, 0x050B, "mul.chk", "none", "..., T, T -> ..., T")
SEAM_BYTECODE_OPCODE(and, 0x0600, "and", "none", "..., T, T -> ..., T")
SEAM_BYTECODE_OPCODE(or, 0x0601, "or", "none", "..., T, T -> ..., T")
SEAM_BYTECODE_OPCODE(xor, 0x0602, "xor", "none", "..., T, T -> ..., T")
SEAM_BYTECODE_OPCODE(not, 0x0603, "not", "none", "..., T -> ..., T")
SEAM_BYTECODE_OPCODE(shl, 0x0610, "shl", "none", "..., T, Nat -> ..., T")
SEAM_BYTECODE_OPCODE(shr, 0x0611, "shr", "none", "..., T, Nat -> ..., T")
SEAM_BYTECODE_OPCODE(sar, 0x0612, "sar", "none", "..., T, Nat -> ..., T")
SEAM_BYTECODE_OPCODE(rol, 0x0613, "rol", "none", "..., T, Nat -> ..., T")
SEAM_BYTECODE_OPCODE(ror, 0x0614, "ror", "none", "..., T, Nat -> ..., T")
SEAM_BYTECODE_OPCODE(cmpEq, 0x0700, "cmp.eq", "none", "..., A, A -> ..., Bit")
SEAM_BYTECODE_OPCODE(cmpNe, 0x0701, "cmp.ne", "none", "..., A, A -> ..., Bit")
SEAM_BYTECODE_OPCODE(cmpLt, 0x0702, "cmp.lt", "none", "..., T, T -> ..., Bit")
SEAM_BYTECODE_OPCODE(cmpLe, 0x0703, "cmp.le", "none", "..., T, T -> ..., Bit")
SEAM_BYTECODE_OPCODE(cmpGt, 0x0704, "cmp.gt", "none", "..., T, T -> ..., Bit")
SEAM_BYTECODE_OPCODE(cmpGe, 0x0705, "cmp.ge", "none", "..., T, T -> ..., Bit")
SEAM_BYTECODE_OPCODE(cmpLtUn, 0x0706, "cmp.lt.un", "none", "..., T, T -> ..., Bit")
SEAM_BYTECODE_OPCODE(cmpLeUn, 0x0707, "cmp.le.un", "none", "..., T, T -> ..., Bit")
SEAM_BYTECODE_OPCODE(cmpGtUn, 0x0708, "cmp.gt.un", "none", "..., T, T -> ..., Bit")
SEAM_BYTECODE_OPCODE(cmpGeUn, 0x0709, "cmp.ge.un", "none", "..., T, T -> ..., Bit")
SEAM_BYTECODE_OPCODE(testTy, 0x0710, "test.ty", "type_idx", "..., A -> ..., Bit")
SEAM_BYTECODE_OPCODE(castTy, 0x0711, "cast.ty", "type_idx", "..., A -> ..., T")
SEAM_BYTECODE_OPCODE(conv, 0x0800, "conv", "type_idx", "..., A -> ..., T")
SEAM_BYTECODE_OPCODE(convChk, 0x0801, "conv.chk", "type_idx", "..., A -> ..., T")
SEAM_BYTECODE_OPCODE(bitcast, 0x0802, "bitcast", "type_idx", "..., A -> ..., T")
SEAM_BYTECODE_OPCODE(convRepr, 0x0803, "conv.repr", "type_idx", "..., A -> ..., T")
SEAM_BYTECODE_OPCODE(ldRef, 0x0900, "ld.ref", "none", "..., Ref[T] -> ..., T")
SEAM_BYTECODE_OPCODE(stRef, 0x0901, "st.ref", "none", "..., Ref[T], T -> ...")
SEAM_BYTECODE_OPCODE(ldPtr, 0x0902, "ld.ptr", "type_idx", "..., Ptr[T] -> ..., T")
SEAM_BYTECODE_OPCODE(stPtr, 0x0903, "st.ptr", "type_idx", "..., Ptr[T], T -> ...")
SEAM_BYTECODE_OPCODE(ldAddr, 0x0904, "ld.addr", "addr_idx", "... -> ..., Ref[T]")
SEAM_BYTECODE_OPCODE(alloc, 0x0905, "alloc", "type_idx", "... -> ..., Ref[T]")
SEAM_BYTECODE_OPCODE(allocArr, 0x0906, "alloc.arr", "type_idx", "..., Nat -> ..., Ref[T]")
SEAM_BYTECODE_OPCODE(memCopy, 0x0910, "mem.copy", "none", "..., Ptr[dst], Ptr[src], Nat -> ...")
SEAM_BYTECODE_OPCODE(memFill, 0x0911, "mem.fill", "none", "..., Ptr[dst], Byte, Nat -> ...")
SEAM_BYTECODE_OPCODE(memMove, 0x0912, "mem.move", "none", "..., Ptr[dst], Ptr[src], Nat -> ...")
SEAM_BYTECODE_OPCODE(size, 0x0913, "size", "type_idx", "... -> ..., Nat")
SEAM_BYTECODE_OPCODE(mkProd, 0x0A00, "mk.prod", "type_idx", "..., fields(T) -> ..., T")
SEAM_BYTECODE_OPCODE(ldFld, 0x0A01, "ld.fld", "field_idx", "..., P -> ..., F")
SEAM_BYTECODE_OPCODE(stFld, 0x0A02, "st.fld", "field_idx", "..., Ref[P], F -> ...")
SEAM_BYTECODE_OPCODE(addrFld, 0x0A04, "addr.fld", "field_idx", "..., Ref[P] -> ..., Ref[F]")
SEAM_BYTECODE_OPCODE(ldIdx, 0x0A10, "ld.idx", "field_idx", "..., P -> ..., F")
SEAM_BYTECODE_OPCODE(stIdx, 0x0A11, "st.idx", "field_idx", "..., Ref[P], F -> ...")
SEAM_BYTECODE_OPCODE(addrIdx, 0x0A13, "addr.idx", "field_idx", "..., Ref[P] -> ..., Ref[F]")
SEAM_BYTECODE_OPCODE(mkSum, 0x0B00, "mk.sum", "alt_idx", "..., payld? -> ..., S")
SEAM_BYTECODE_OPCODE(ldTag, 0x0B01, "ld.tag", "type_idx", "..., S -> ..., Nat")
SEAM_BYTECODE_OPCODE(isTag, 0x0B02, "is.tag", "alt_idx", "..., S -> ..., Bit")
SEAM_BYTECODE_OPCODE(ldPayld, 0x0B03, "ld.payld", "alt_idx", "..., S -> ..., P")
SEAM_BYTECODE_OPCODE(hasPayld, 0x0B04, "has.payld", "alt_idx", "..., S -> ..., Bit")
SEAM_BYTECODE_OPCODE(addrPayld, 0x0B05, "addr.payld", "alt_idx", "..., Ref[S] -> ..., Ref[P]")
SEAM_BYTECODE_OPCODE(mkArr, 0x0C00, "mk.arr", "type_idx, varu", "..., elems[N] -> ..., T")
SEAM_BYTECODE_OPCODE(len, 0x0C01, "len", "none", "..., T -> ..., Nat")
SEAM_BYTECODE_OPCODE(ldElem, 0x0C02, "ld.elem", "none", "..., T, Nat -> ..., E")
SEAM_BYTECODE_OPCODE(stElem, 0x0C03, "st.elem", "none", "..., Ref[T], Nat, E -> ...")
SEAM_BYTECODE_OPCODE(addrElem, 0x0C04, "addr.elem", "none", "..., Ref[T], Nat -> ..., Ref[E]")
SEAM_BYTECODE_OPCODE(box, 0x0E00, "box", "type_idx", "..., T -> ..., B")
SEAM_BYTECODE_OPCODE(unbox, 0x0E01, "unbox", "type_idx", "..., B -> ..., T")
SEAM_BYTECODE_OPCODE(capHas, 0x0E02, "cap.has", "cap_idx", "..., A -> ..., Bit")
SEAM_BYTECODE_OPCODE(capNeed, 0x0E03, "cap.need", "cap_idx", "..., A -> ..., A")
SEAM_BYTECODE_OPCODE(ldKey, 0x0E04, "ld.key", "none", "..., Obj, Key -> ..., Value")
SEAM_BYTECODE_OPCODE(stKey, 0x0E05, "st.key", "none", "..., Obj, Key, Value -> ...")
SEAM_BYTECODE_OPCODE(hasKey, 0x0E06, "has.key", "none", "..., Obj, Key -> ..., Bit")
SEAM_BYTECODE_OPCODE(delKey, 0x0E07, "del.key", "none", "..., Obj, Key -> ..., Bit")
SEAM_BYTECODE_OPCODE(yld, 0x1000, "yld", "sig_idx", "..., yield(S) -> ..., resume(S)")
SEAM_BYTECODE_OPCODE(clnPush, 0x1100, "cln.push", "region_idx", "... -> ...")
SEAM_BYTECODE_OPCODE(clnPop, 0x1101, "cln.pop", "region_idx", "... -> ...")
SEAM_BYTECODE_OPCODE(clnRun, 0x1102, "cln.run", "region_idx", "... -> ...")

#undef SEAM_BYTECODE_OPCODE
